{
  "name": "domdom-inspector",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DomDom Inspector — DOM/HTML/CSS デザイン計測 (色/余白/角丸 + デザイントークン照合) Chrome 拡張",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wxt": "^0.20.0"
  }
}
