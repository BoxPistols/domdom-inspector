{
  "name": "domdom-inspector",
  "version": "0.4.14",
  "private": true,
  "type": "module",
  "description": "DomDom Inspector — DOM/HTML/CSS デザイン計測 (色/余白/角丸 + デザイントークン照合) Chrome 拡張",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/sync-extension.mjs --auto",
    "build:only": "wxt build",
    "sync": "node scripts/sync-extension.mjs",
    "shots": "node scripts/store-screenshots.mjs",
    "check:submission": "node scripts/submission-check.mjs",
    "build:sync": "wxt build && node scripts/sync-extension.mjs",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.0",
    "wxt": "^0.20.0"
  }
}
